# Environnement Node — production en staging/prod, development en local/dev.yml
NODE_ENV=development

JWT_EXPIRES_IN=7d
PORT=3000

# JWT signing secret (optionnel) — si absent, le code retombe sur ENCRYPTION_KEY.
JWT_SECRET=

# Server URL for email links (password reset, invitations)
APP_URL=http://localhost:5173

# CORS: Comma-separated allowed origins for console endpoints
# Track endpoints (/api/track*) always allow all origins for SDK
# Default: * (allow all origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo fixtures generation (optional)
DEMO_SECRET=your-demo-secret-change-in-production

# Demo mode - set to true to disable write operations (workspace create, API key create, etc.)
IS_DEMO=false

# ClickHouse
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_SYSTEM_DATABASE=staminads_system
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Custom Dimensions Cache (optional)
CUSTOM_DIMENSIONS_CACHE_TTL_MS=15000

# Geo Location (optional)
# Path to MaxMind GeoLite2-City.mmdb database
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# Encryption key for sensitive data (REQUIRED)
# Must be at least 32 characters. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Webhook encryption key (OPTIONAL — falls back to ENCRYPTION_KEY when unset)
# Used to encrypt webhook auth secrets (Bearer / Basic / HMAC) at rest.
# Format: 64-char hex (32 bytes). Generate with: openssl rand -hex 32
# Rotation: Phase 2 (cf todo/PATTERNS-WEBHOOKS.md §8). Rotating today
# invalidates all stored secrets — re-create webhooks after rotation.
WEBHOOK_ENCRYPTION_KEY=

# Allow http:// webhook destinations (staging/dev only).
# HTTPS is enforced when WEBHOOK_ALLOW_HTTP != "true".
WEBHOOK_ALLOW_HTTP=

# Allow webhook destinations on private / loopback IPs (TEST ONLY).
# Defaults to false. Production keeps this unset.
WEBHOOK_ALLOW_PRIVATE_IPS=

# Global SMTP settings (optional)
# If not set, workspace-level SMTP must be configured to send emails
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Veridian Analytics
SMTP_FROM_EMAIL=noreply@veridian.site

# AI Assistant (optional) — kill-switch for interleaved thinking.
# Set to 1 if the assistant model rejects thinking config.
# The Anthropic API key is stored per-workspace (encrypted in DB), not here.
ASSISTANT_THINKING_DISABLED=

# Backfill (optional) — minutes before a backfill job is considered stale.
BACKFILL_STALE_THRESHOLD_MINUTES=5

# Security headers — fallback report-only mode si la CSP casse une route en
# staging (BUG-17). Mettre "true" temporairement pour passer en mode
# Content-Security-Policy-Report-Only au lieu de Content-Security-Policy.
# Laisser vide en prod = enforcement strict.
CSP_REPORT_ONLY=

# Platform admin M2M key (REQUIRED for /api/admin/platform/* routes)
# Single shared secret used by the Hub / Veridian provisioning skill to
# provision tenants via POST /api/admin/platform/tenants.provision.
# NEVER expose to customers. Rotate via Dokploy ENV + restart compose.
# Generate with: openssl rand -base64 48
# If unset → all /api/admin/platform/* requests return 401 (fail-closed).
PLATFORM_ADMIN_API_KEY=

# Bridge service URL (optional) — used by tenants.provision to forward
# phone numbers to the bridge's TenantPhoneNumber table. If unset, the
# phoneNumbers payload is recorded as `skipped_no_bridge` and the Hub
# must retry once the bridge is online.
BRIDGE_URL=
BRIDGE_ADMIN_API_KEY=

# Public origin of the tracker.js asset (defaults to prod).
# Used to build the snippet_html returned by tenants.provision.
TRACKER_PUBLIC_ORIGIN=https://analytics-engine.app.veridian.site
