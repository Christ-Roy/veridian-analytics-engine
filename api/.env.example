# Environnement Node — production en staging/prod, development en local/dev.yml
NODE_ENV=development

JWT_EXPIRES_IN=7d
PORT=3000

# JWT signing secret (optionnel) — si absent, le code retombe sur ENCRYPTION_KEY.
JWT_SECRET=

# Server URL for email links (password reset, invitations)
APP_URL=http://localhost:5173

# CORS: Comma-separated allowed origins for console endpoints
# Track endpoints (/api/track*) always allow all origins for SDK
# Default: * (allow all origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Reverse-proxy hops in front of the app (anti-spoofing IP/géo). The app sits
# behind exactly ONE trusted proxy (Traefik) in prod/staging/demo → default 1.
# Express uses this to derive a non-spoofable req.ip from X-Forwarded-For.
# Raise only if a CDN (e.g. Cloudflare proxy) is added in front of Traefik.
TRUST_PROXY_HOPS=1

# Ingestion rate limit for POST /api/track (anti-DoS/flood). Bucketed per
# (workspace_id + IP), NOT per raw IP — a large NATed site is never throttled,
# only a flood concentrated on one workspace+IP hits the ceiling. Generous
# defaults: 600 requests / 60s per bucket. Tune up for very high-volume sites.
INGEST_THROTTLE_LIMIT=600
INGEST_THROTTLE_TTL=60000

# Demo fixtures generation (optional)
DEMO_SECRET=your-demo-secret-change-in-production

# Demo mode - set to true to disable write operations (workspace create, API key create, etc.)
IS_DEMO=false

# ClickHouse
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_SYSTEM_DATABASE=staminads_system
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Bounded startup readiness retry. This absorbs the short race when the API and
# ClickHouse start concurrently in the same Nomad allocation; fatal errors are
# still surfaced after the retry budget.
CLICKHOUSE_STARTUP_RETRY_ATTEMPTS=12
CLICKHOUSE_STARTUP_RETRY_DELAY_MS=500
# Query timeouts (optional, sane defaults). max_execution_time (s) bounds the
# server-side query; request_timeout (ms) bounds the client HTTP wait. Keep
# request_timeout > max_execution_time*1000 so the server kills runaway queries
# first instead of leaking a pinned pool connection.
CLICKHOUSE_MAX_EXECUTION_TIME=30
CLICKHOUSE_REQUEST_TIMEOUT_MS=60000

# Custom Dimensions Cache (optional)
CUSTOM_DIMENSIONS_CACHE_TTL_MS=15000

# Geo Location (optional)
# Path to MaxMind GeoLite2-City.mmdb database
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# Encryption key for sensitive data (REQUIRED)
# Must be at least 32 characters. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Google Search Console (GSC) — module natif (onglet Settings « Search Console »)
# OAuth client du projet Google Cloud `veridian-preprod`. Si l'un de ces 3 est
# absent → la feature GSC est désactivée (oauth-begin renvoie 503, le cron de
# sync est un no-op). Les tokens OAuth sont chiffrés avec ENCRYPTION_KEY
# (clé dérivée par workspace), pas une clé dédiée.
# ⚠️ REDIRECT URI : doit être déclarée à l'identique dans Google Cloud Console
#    → https://analytics-engine.app.veridian.site/api/gsc/oauth-callback (prod)
#    → https://analytics-engine.staging.veridian.site/api/gsc/oauth-callback (staging)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# URL de retour console après consentement OAuth (onglet Search Console).
# Optionnel : si absent, le callback renvoie un JSON au lieu de rediriger.
GSC_OAUTH_SUCCESS_REDIRECT=
# Kill-switch du cron de sync GSC (1×/jour 04:00). "true" pour le désactiver.
GSC_SYNC_CRON_DISABLED=

# Webhook encryption key (OPTIONAL — falls back to ENCRYPTION_KEY when unset)
# Used to encrypt webhook auth secrets (Bearer / Basic / HMAC) at rest.
# Format: 64-char hex (32 bytes). Generate with: openssl rand -hex 32
# Rotation: Phase 2 (cf todo/PATTERNS-WEBHOOKS.md §8). Rotating today
# invalidates all stored secrets — re-create webhooks after rotation.
WEBHOOK_ENCRYPTION_KEY=

# Allow http:// webhook destinations (staging/dev only).
# HTTPS is enforced when WEBHOOK_ALLOW_HTTP != "true".
WEBHOOK_ALLOW_HTTP=

# Allow webhook destinations on private / loopback IPs (TEST ONLY).
# Defaults to false. Production keeps this unset.
WEBHOOK_ALLOW_PRIVATE_IPS=

# Webhook delivery worker single-leader gate. Defaults to TRUE.
# The delivery-queue claim is NOT atomic (ClickHouse has no transaction/lock),
# so correctness relies on exactly ONE process draining the queue. With a single
# instance (current prod), leave this unset/true. To scale the API to N replicas,
# set WEBHOOK_WORKER_LEADER=false on every replica BUT one — otherwise two
# workers read the same pending row and double-POST generic webhooks.
# Only the exact value "false" (case-insensitive) demotes a replica; anything
# else (incl. unset) means leader. Cf docs/runbooks/webhook-worker-single-leader.md.
WEBHOOK_WORKER_LEADER=

# Force the native Twenty destination into dry-run globally (gate à blanc):
# Person resolution stays real, timeline writes are logged not sent.
# Per-webhook override via transform.dry_run. Defaults to false (real writes).
TWENTY_CONNECTOR_DRY_RUN=

# Hard cap on the Twenty Person-resolution cache (optional, default 50000).
# The cache key embeds the visitor identity, so on a high-traffic workspace
# the number of distinct keys is unbounded; past this size we evict oldest
# first to keep memory flat.
TWENTY_PERSON_CACHE_MAX_SIZE=

# Max events retained per workspace in the in-memory ingest buffer when a
# ClickHouse flush fails and events are re-queued (optional, default 50000).
# Past this cap the oldest events are dropped (and counted) to bound memory
# during a CH outage at high ingest volume.
EVENT_BUFFER_MAX_RETAINED=

# VoIP credential encryption key (OPTIONAL — falls back to ENCRYPTION_KEY).
# Encrypts OVH/Telnyx creds at rest (AES-256-GCM, derived per workspace).
# Format: 32+ chars. Generate with: openssl rand -hex 32
VOIP_ENCRYPTION_KEY=

# Enable the native VoIP sync cron (@Cron every 15 min). Defaults to false
# (fail-soft): nothing is pulled until a tenant connects OVH/Telnyx in prod.
# Set to "true" once telephony is live.
VOIP_SYNC_ENABLED=

# Global SMTP settings (optional)
# If not set, workspace-level SMTP must be configured to send emails
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Veridian Analytics
SMTP_FROM_EMAIL=noreply@veridian.site

# Enable the scheduled email reports cron (@Cron every 15 min). Defaults to
# false (fail-soft, same model as VOIP_SYNC_ENABLED): the cron is a no-op until
# the engine's own transactional email channel is wired in prod, so it never
# attempts a send nor pollutes audit_logs with report_failed. Set to "true"
# once a transactional provider is in place.
SUBSCRIPTIONS_ENABLED=

# AI Assistant (optional) — kill-switch for interleaved thinking.
# Set to 1 if the assistant model rejects thinking config.
# The Anthropic API key is stored per-workspace (encrypted in DB), not here.
ASSISTANT_THINKING_DISABLED=

# Backfill (optional) — minutes before a backfill job is considered stale.
BACKFILL_STALE_THRESHOLD_MINUTES=5

# Security headers — fallback report-only mode si la CSP casse une route en
# staging (BUG-17). Mettre "true" temporairement pour passer en mode
# Content-Security-Policy-Report-Only au lieu de Content-Security-Policy.
# Laisser vide en prod = enforcement strict.
CSP_REPORT_ONLY=

# Platform admin M2M key (REQUIRED for /api/admin/platform/* routes)
# Single shared secret used by the Hub / Veridian provisioning skill to
# provision tenants via POST /api/admin/platform/tenants.provision.
# NEVER expose to customers. Rotate via Dokploy ENV + restart compose.
# Generate with: openssl rand -base64 48
# If unset → all /api/admin/platform/* requests return 401 (fail-closed).
PLATFORM_ADMIN_API_KEY=

# Bridge service URL (optional) — used by tenants.provision to forward
# phone numbers to the bridge's TenantPhoneNumber table. If unset, the
# phoneNumbers payload is recorded as `skipped_no_bridge` and the Hub
# must retry once the bridge is online.
BRIDGE_URL=
BRIDGE_ADMIN_API_KEY=
# Per-call timeout (ms) for the bridge phone-number forward during provisioning
# (optional, default 10000). The provisioning loop is sequential, so this stops
# a hung bridge from freezing the whole provision call; on timeout the number
# is recorded as failed with error 'bridge_timeout'.
BRIDGE_REQUEST_TIMEOUT_MS=

# tracking.verify site probe: allow http:// client sites (optional, default
# allowed — set to "false" to require https). The probe always runs the
# SsrfGuard (blocks private/loopback/metadata) regardless of this flag.
TRACKING_VERIFY_ALLOW_HTTP=

# Public origin of the tracker.js asset (defaults to prod).
# Used to build the snippet_html returned by tenants.provision.
TRACKER_PUBLIC_ORIGIN=https://analytics-engine.app.veridian.site
