{
  "name": "@veridian/e2e-battery",
  "private": true,
  "version": "0.2.0",
  "description": "End-to-end test battery for Veridian Analytics Engine — runs against live staging/prod URLs. No local build, CI only.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:gate": "playwright test 00-gate-onpremise/",
    "test:smoke": "playwright test 01-smoke/",
    "test:hub-contract": "playwright test 06-hub-contract/",
    "test:demo": "playwright test 11-demo-public/",
    "test:bugs": "playwright test 02-bugs-regression/",
    "test:tracker": "playwright test 02-tracker-to-dashboard/",
    "test:gsc": "playwright test 05-gsc-oauth/",
    "test:settings": "playwright test 07-settings-credentials/",
    "test:voip": "playwright test 08-voip-calls/",
    "test:dashboard-ui": "playwright test 09-dashboard-ui/",
    "test:onboarding": "playwright test 10-onboarding-wizard/",
    "test:auth": "playwright test 12-auth-flow/",
    "test:perf": "playwright test 14-perf-regression/",
    "test:chaos": "playwright test 15-chaos/",
    "test:security": "playwright test 16-security/ 17-multi-tenant-isolation/ 18-api-contract/",
    "test:sdk": "playwright test 19-sdk-tracker/",
    "test:critical": "playwright test --grep @critical",
    "test:turbo-p0": "playwright test 00-gate-onpremise/ 01-smoke/ 02-bugs-regression/ 06-hub-contract/ 12-auth-flow/ 16-security/ 17-multi-tenant-isolation/ 18-api-contract/",
    "test:turbo-p1": "playwright test 02-tracker-to-dashboard/ 09-dashboard-ui/ 10-onboarding-wizard/ 19-sdk-tracker/",
    "test:turbo-all": "playwright test",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
