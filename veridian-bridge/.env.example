# ─── Veridian Bridge — .env.example ────────────────────────────────────────
#
# Copier en .env (local) ou injecter via Dokploy/ENV (staging/prod).
# JAMAIS commiter de vraies valeurs.

# ─── Staminads (analytics engine) ──────────────────────────────────────────
# STAMINADS_URL = service interne Docker (nom de service compose `engine`).
STAMINADS_URL=http://engine:3000
PUBLIC_STAMINADS_URL=https://analytics-engine.app.veridian.site

# Clé M2M partagée bridge ↔ Engine (Bearer PLATFORM_ADMIN_API_KEY côté Engine,
# PlatformAdminGuard timing-safe). Remplace l'ancien couple super_admin
# email/password (anti-pattern getAdminToken, retiré 2026-06-16 — cf.
# docs/PLATFORM-ADMIN-API.md). DOIT être la MÊME valeur que côté Engine.
# Générer : openssl rand -base64 48
PLATFORM_ADMIN_API_KEY=

# ─── Bridge admin API ─────────────────────────────────────────────────────
# Bearer pour /api/admin/* (provision-tenant, track-test, analytics)
VERIDIAN_ADMIN_API_KEY=

# ─── Hub HMAC (B3 — contrat §5.1, §5.3, §5.5, §6.1) ───────────────────────
# Secret partagé entre Hub Veridian et le bridge. 32+ chars hex.
# Convention CONTRAT-HUB §6.5 : variables séparées staging/prod côté Hub,
# mais côté bridge c'est la MÊME variable — c'est le .env qui change selon
# l'environnement.
#
# Source : ~/credentials/.all-creds.env → HUB_HMAC_SECRET_ANALYTICS_STAGING
#                                       → HUB_HMAC_SECRET_ANALYTICS_PROD
# Côté Hub :
#   - staging : ANALYTICS_HUB_API_SECRET_STAGING
#   - prod    : ANALYTICS_HUB_API_SECRET
HUB_HMAC_SECRET=

# Mode dev local : bypass HMAC pour coder sans monter un faux Hub signer.
# - JAMAIS toléré en production ou staging (assertSkipHmacAllowed() throw au boot)
# - À utiliser uniquement en NODE_ENV=test ou NODE_ENV=development
# Cf. CONTRAT-HUB §6.6.
SKIP_HMAC=false

# ─── Hub webhook (App → Hub) ──────────────────────────────────────────────
# Pour les futurs webhooks tenant.suspended / tenant.deleted (S3).
HUB_API_URL=https://app.veridian.site
HUB_WEBHOOK_TOKEN=

# ─── Dashboard URL renvoyé par /provision ────────────────────────────────
# URL publique du dashboard Veridian Analytics renvoyée au Hub à la réponse
# du POST /api/tenants/provision (cf CONTRAT-HUB §5.1). Le Hub la stocke
# dans la table `tenants` pour le bouton "Voir analytics" côté dashboard.
PUBLIC_DASHBOARD_URL=https://analytics.app.veridian.site

# ─── Bridge ────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
PUBLIC_DASHBOARD_URL=https://analytics.app.veridian.site

# ─── GSC integration (A4) ─────────────────────────────────────────────────
# Postgres dédié au bridge (separée des ClickHouse staminads).
# DB créée par le service compose `postgres-bridge` (cf compose/dev.yml).
BRIDGE_DATABASE_URL=postgresql://bridge:bridge_pwd@postgres-bridge:5432/veridian_bridge
BRIDGE_DB_HOST=postgres-bridge
BRIDGE_DB_PORT=5432
BRIDGE_DB_USER=bridge
BRIDGE_DB_PASSWORD=bridge_pwd
BRIDGE_DB_NAME=veridian_bridge

# OAuth Google — credentials à créer dans Google Cloud Console
# (project veridian-preprod ou dédié). Scope: webmasters.readonly.
# Redirect URI doit être enregistrée côté Google : ajouter exactement la
# valeur de GOOGLE_OAUTH_REDIRECT_URI au Client OAuth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://analytics-engine-bridge-dev.staging.veridian.site/api/admin/gsc/oauth-callback

# Clé AES-256-GCM pour chiffrer les tokens OAuth en DB.
# Générer via: openssl rand -hex 32  (DOIT faire 64 chars hex = 32 bytes)
TOKEN_ENCRYPTION_KEY=

# Optionnel : URL de redirect post-OAuth-callback (vers le dashboard frontal)
# Si absent, le callback retourne JSON au lieu de rediriger.
GSC_DASHBOARD_REDIRECT_URL=https://analytics.staging.veridian.site/admin/tenants

# Optionnel : liste d'IPs autorisées pour /api/admin/gsc/sync-all (cron interne).
# Comma-separated. Si vide, seul Bearer admin est accepté.
GSC_CRON_ALLOWED_IPS=

# ─── Push Notifications PWA (B2) ──────────────────────────────────────────
# Clés VAPID Web Push — DOIVENT correspondre aux clés legacy
# `veridian-analytics/lib/web-push.ts` côté Next pour ne PAS invalider les
# abonnements PushSubscription historiques (cf. D2 migration).
#
# Source : ~/credentials/.all-creds.env → VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY
#
# Si jamais on doit régénérer (perte des clés) :
#   npx web-push generate-vapid-keys
# Tous les abonnements existants devront re-souscrire côté browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@veridian.site

# ─── VoIP call logs (B-VOIP) ──────────────────────────────────────────────
# Le bridge pull les CDR (call logs) des tenants ayant branché un provider
# VoIP (OVH Telephony / Telnyx). Les credentials provider sont saisis par le
# tenant via la page Settings (U8) et stockés chiffrés AES-256-GCM dans la
# table TenantCredential — clé = TOKEN_ENCRYPTION_KEY (ci-dessus, partagée
# avec GSC). Aucune clé provider en ENV : chaque tenant fournit les siennes.
#
# La feature VoIP s'active automatiquement si BRIDGE_DATABASE_URL ET
# TOKEN_ENCRYPTION_KEY sont présents.
#
# Optionnel : liste d'IPs autorisées pour /api/admin/voip/sync-all (cron),
# comma-separated. Si vide, seul Bearer admin est accepté.
VOIP_CRON_ALLOWED_IPS=

# ─── Variables de TEST uniquement (jamais en déploiement) ─────────────────
# Utilisées par les tests d'intégration / e2e du bridge, pas au runtime prod.
#
# BRIDGE_TEST_DATABASE_URL : Postgres "template" pour les tests d'intégration
#   (le harness crée une DB jetable). Défaut : postgres local.
# BRIDGE_URL               : si défini, les tests Playwright pointent dessus
#   (smoke CI staging/prod) au lieu de booter un bridge local.
# STAMINADS_TEST_URL       : engine cible pour les tests d'intégration.
# CLICKHOUSE_TEST_HOST     : ClickHouse de test (défaut http://127.0.0.1:58123).
# KEEP_TEST_DB=1           : ne pas DROP la base jetable après les tests (debug).
# BRIDGE_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# BRIDGE_URL=
# STAMINADS_TEST_URL=
# CLICKHOUSE_TEST_HOST=
# KEEP_TEST_DB=
