# Dockerfile.dev — Bridge Veridian en watch mode (tsx watch) + Prisma
#
# Le bridge tourne en `tsx watch` via `npm run dev`. Pas de compilation —
# Prisma client généré au build (postinstall) puis disponible en runtime.

FROM node:22-alpine

RUN apk add --no-cache wget

WORKDIR /app

COPY package.json package-lock.json tsconfig.json ./
COPY prisma ./prisma

# npm ci lance le postinstall qui appelle `prisma generate`.
RUN npm ci --no-audit --no-fund

# src/ et tests/ bind-montés en runtime par compose/dev.yml

EXPOSE 3002

# Au boot dev : migrate deploy (best-effort) puis dev hot-reload.
# On garde `|| true` car en dev on prefere booter même si la DB n'est pas prête
# (le bridge log le warning et continue sans GSC).
CMD ["sh", "-c", "npx prisma migrate deploy --schema=./prisma/schema.prisma || true; npm run dev"]
