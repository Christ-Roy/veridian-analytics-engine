{
  "name": "veridian-poc-bridge-stub",
  "version": "0.1.0",
  "private": true,
  "description": "POC bridge Veridian → staminads (simule le futur layer veridian-analytics)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test --test-reporter=spec 'tests/!(*.integration).test.ts' 'tests/hub/!(*.integration).test.ts' 'tests/integration/!(*.integration).test.ts' 'tests/forms/!(*.integration).test.ts' 'tests/push/!(*.integration).test.ts'",
    "test:ci": "node --import tsx --test --test-reporter=tap 'tests/!(*.integration).test.ts' 'tests/hub/!(*.integration).test.ts' 'tests/integration/!(*.integration).test.ts' 'tests/forms/!(*.integration).test.ts' 'tests/push/!(*.integration).test.ts'",
    "test:integration": "node --import tsx --test --test-reporter=spec 'tests/**/*.integration.test.ts'",
    "test:integration:ci": "node --import tsx --test --test-reporter=tap 'tests/**/*.integration.test.ts'",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke/",
    "test:e2e:promise": "playwright test tests/e2e/promise-flows/",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma || true"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.3.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "picomatch": "^4.0.4"
  }
}
