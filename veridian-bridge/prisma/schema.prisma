// Veridian Bridge — schéma Postgres (DB `veridian_bridge`)
//
// Premier schéma BDD du bridge. Modèles :
//   - Tenant      : un par site client (ref staminads workspace + Hub)
//   - GscProperty : propriété Search Console attachée à un tenant
//   - GscDaily    : rows daily GSC (clicks/impressions/position) groupées
//                   par (date, query, page, country, device, searchType)
//
// Coordination cross-tickets :
//   - A4 (ce ticket)  : crée Tenant + GscProperty + GscDaily
//   - B3              : étend Tenant pour intégration Hub (déjà inclus ici en colonnes optionnelles
//                       pour que B3 n'ait qu'à câbler les endpoints — pas à toucher le schéma)
//
// Chiffrement : `GscProperty.oauthAccount` stocke les tokens OAuth Google
// au format AES-256-GCM (cf src/gsc/oauth.ts). JAMAIS de clear text en DB.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("BRIDGE_DATABASE_URL")
}

// ─── Tenant ───────────────────────────────────────────────────────────────
//
// Un Tenant = 1 client Veridian Analytics.
// - workspaceId : id staminads (workspace dans ClickHouse)
// - hubTenantId : id côté Hub (B3 câblera la sync)
// - plan / planSource / status / apiKey / suspendedAt / softDeletedAt :
//   champs étendus pour B3, déclarés ici dès A4 pour éviter une migration
//   ultérieure quand B3 prendra le ticket.

model Tenant {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  slug            String    @unique
  name            String

  // Hub integration (B3 consomme ces colonnes)
  hubTenantId     String?   @unique
  plan            String    @default("free")
  planSource      String?   // "hub" | "manual" | "trial"
  status          String    @default("active") // "active" | "suspended" | "soft_deleted"
  apiKey          String?   @unique
  suspendedAt     DateTime?
  softDeletedAt   DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  gscProperties     GscProperty[]
  sites             Site[]
  pushSubscriptions PushSubscription[]
  pushNotifications PushNotification[]
  credentials       TenantCredential[]
  settings          TenantSettings?
  sipCalls          SipCall[]

  @@index([status])
  @@index([hubTenantId])
}

// ─── TenantCredential (U8) ─────────────────────────────────────────────────
//
// Credentials self-service que le tenant saisit lui-même via la page
// /settings de la console — provider VoIP (OVH Telephony, Telnyx, ...) pour
// que le bridge pull les call logs (`sipCall` legacy) via un cron (ticket
// B-VOIP séparé).
//
// `kind` identifie le type de credential : "voip_ovh" | "voip_telnyx" | ...
// (extensible). Contrainte `@@unique([tenantId, kind])` : un seul credential
// par couple (tenant, provider).
//
// `encryptedData` (Json) contient les creds chiffrés AES-256-GCM, MÊME format
// que `GscProperty.oauthAccount` (cf src/credentials/crypto.ts) :
//   { v: 1, iv: "<hex>", tag: "<hex>", ciphertext: "<hex>" }
// Le clear-text déchiffré est un objet provider-specific :
//   - voip_ovh    : { applicationKey, applicationSecret, consumerKey }
//   - voip_telnyx : { apiKey }
// JAMAIS de clear text en DB. L'API ne renvoie JAMAIS les creds déchiffrés —
// uniquement une vue masquée (`••••1234`).
//
// `status`     : "untested" (saisi, pas encore testé) | "ok" | "failed"
// `lastSyncAt` : dernier pull de logs VoIP réussi (rempli par le cron B-VOIP)

model TenantCredential {
  id            String    @id @default(cuid())
  tenantId      String
  kind          String    // 'voip_ovh' | 'voip_telnyx' | ...
  encryptedData Json      // creds chiffrés AES-256-GCM
  status        String    @default("untested") // untested | ok | failed
  lastSyncAt    DateTime?
  lastTestedAt  DateTime?
  lastError     String?   // dernier message d'erreur de "test connexion"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind])
  @@index([tenantId])
}

// ─── TenantSettings (U8) ───────────────────────────────────────────────────
//
// Préférences self-service d'un Tenant éditées via la page /settings :
// notifications email, préférences push admin, toggles tracking (visitor_id,
// cookie consent). 1:1 avec Tenant (relation optionnelle — créée à la
// première écriture via upsert).
//
// Le domaine / siteKey du site ne vivent PAS ici : ils sont sur `Site`.
// Cette table ne porte QUE des préférences scalaires côté tenant.

model TenantSettings {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  // Notifications
  notifyNewLead       Boolean  @default(true)
  notifyWeeklyReport  Boolean  @default(true)
  notifyEmail         String?  // email destinataire des notifs (override compte)
  pushAdminEnabled    Boolean  @default(true)
  // Tracking
  visitorIdEnabled    Boolean  @default(true)
  cookieConsentEnabled Boolean @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── GscProperty ──────────────────────────────────────────────────────────
//
// Propriété Search Console rattachée à un Tenant. `siteUrl` est l'identifiant
// GSC tel qu'attendu par l'API (ex : "sc-domain:exemple.fr" ou
// "https://www.exemple.fr/").
//
// `oauthAccount` (Json) contient les tokens chiffrés via AES-256-GCM :
//   {
//     iv: "<hex>",
//     tag: "<hex>",
//     ciphertext: "<hex>",   // JSON chiffré { access_token, refresh_token, expires_at, scope }
//     v: 1
//   }

model GscProperty {
  id              String    @id @default(cuid())
  tenantId        String
  siteUrl         String
  type            String    // "SITE" | "DOMAIN"
  ownershipState  String    @default("pending") // "verified" | "pending" | "failed"
  lastSyncAt      DateTime?
  oauthAccount    Json?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dailyRows       GscDaily[]

  @@unique([tenantId, siteUrl])
  @@index([ownershipState])
}

// ─── GscDaily ─────────────────────────────────────────────────────────────
//
// Une row par combinaison (date, query, page, country, device, searchType)
// pour chaque GscProperty. `query`/`page`/`country`/`device` peuvent être
// vides ("") quand l'aggregation se fait sur l'autre dimension.

model GscDaily {
  id              String    @id @default(cuid())
  gscPropertyId   String
  date            DateTime  @db.Date
  query           String    @default("")
  page            String    @default("")
  country         String    @default("")
  device          String    @default("")
  searchType      String    @default("web")
  impressions     Int       @default(0)
  clicks          Int       @default(0)
  position        Float     @default(0)
  ctr             Float     @default(0)

  createdAt       DateTime  @default(now())

  gscProperty     GscProperty @relation(fields: [gscPropertyId], references: [id], onDelete: Cascade)

  @@unique([gscPropertyId, date, query, page, country, device, searchType])
  @@index([gscPropertyId, date])
}

// ─── Site ─────────────────────────────────────────────────────────────────
//
// Un Site = un domaine client tracké par le tracker Veridian. Plusieurs Sites
// possibles par Tenant (multi-domaines), mais en pratique 1:1 au début.
// `siteKey` = clé publique posée dans le snippet tracker, utilisée pour
// authentifier les POST /api/ingest/form depuis le navigateur du visiteur.

model Site {
  id              String   @id @default(cuid())
  tenantId        String
  siteKey         String   @unique
  domain          String
  name            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formSchemas     FormSchema[]
  formSubmissions FormSubmission[]
  leads           Lead[]

  @@index([tenantId])
}

// ─── FormSchema ───────────────────────────────────────────────────────────
//
// Description d'un formulaire d'un Site. `formSlug` est l'identifiant
// stable utilisé dans les POST (ex: "contact-devis"). `fields` est un
// JSON array décrivant les champs ([{ name, label, type, required }]).
// Auto-créé au premier POST avec un slug inconnu (cf forms/ingest.ts).

model FormSchema {
  id          String   @id @default(cuid())
  siteId      String
  formSlug    String
  name        String
  fields      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@unique([siteId, formSlug])
}

// ─── FormSubmission ───────────────────────────────────────────────────────
//
// Soumission individuelle de formulaire. `data` est le payload brut envoyé
// par le formulaire (Json), `leadId` rempli si on a pu matcher/créer un Lead
// (email présent dans le payload).

model FormSubmission {
  id            String   @id @default(cuid())
  siteId        String
  formSchemaId  String?
  formSlug      String
  data          Json
  ipAddress     String?
  userAgent     String?
  pageUrl       String?
  visitorId     String?
  sessionId     String?
  leadId        String?
  createdAt     DateTime @default(now())

  site          Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  formSchema    FormSchema? @relation(fields: [formSchemaId], references: [id])
  lead          Lead?       @relation(fields: [leadId], references: [id])

  @@index([siteId, createdAt])
  @@index([leadId])
}

// ─── Lead ─────────────────────────────────────────────────────────────────
//
// Lead = personne identifiée (email) liée à un Site. Dédup par (siteId, email).
// `submissionsCount` incrémenté à chaque POST. `metadata` Json libre.

model Lead {
  id               String   @id @default(cuid())
  siteId           String
  email            String?
  phone            String?
  name             String?
  metadata         Json?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  submissionsCount Int      @default(1)

  site             Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  submissions      FormSubmission[]
  sessions         LeadSession[]

  @@unique([siteId, email])
  @@index([siteId, lastSeenAt])
}

// ─── LeadSession ──────────────────────────────────────────────────────────
//
// Session web liée à un Lead. Matchée par `visitorId` (cookie tracker)
// ou `sessionId` (session staminads). Permet de relier les pageviews
// pré-formulaire à l'identité finale.

model LeadSession {
  id            String    @id @default(cuid())
  leadId        String
  visitorId     String?
  sessionId     String?
  source        String?
  medium        String?
  campaign      String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  pageviewCount Int       @default(1)

  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ─── PushSubscription ─────────────────────────────────────────────────────
//
// Un abonnement Web Push enregistré côté browser (PWA / site client).
// `endpoint` est l'URL du push provider (FCM/APNs/Mozilla) et sert
// d'identifiant unique global.
//
// `keys` = JSON `{ p256dh, auth }` issu de `subscription.getKey()` côté
// browser, base64-url-encoded.
//
// `active=false` quand le push provider retourne 410 Gone (browser
// désinstallé, permission révoquée). On garde la row pour audit mais on
// arrête d'envoyer dessus.

model PushSubscription {
  id          String    @id @default(cuid())
  tenantId    String
  siteId      String?   // optionnel — push lié à un site spécifique
  endpoint    String    @unique
  keys        Json      // { p256dh: string, auth: string }
  userAgent   String?
  visitorId   String?   // cookie vrd_vid si présent
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  active      Boolean   @default(true)

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

// ─── PushNotification ─────────────────────────────────────────────────────
//
// Audit log des notifs push envoyées par un tenant. `targetCount` est le
// nombre de subscriptions actives au moment de l'envoi, `successCount` /
// `failureCount` ce que le push provider a accepté/rejeté.

model PushNotification {
  id           String    @id @default(cuid())
  tenantId     String
  title        String
  body         String
  url          String?
  icon         String?
  targetCount  Int       @default(0)
  successCount Int       @default(0)
  failureCount Int       @default(0)
  sentAt       DateTime  @default(now())
  sentBy       String?   // user id qui a déclenché l'envoi (optionnel)

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sentAt])
}

// ─── SipCall (B-VOIP) ──────────────────────────────────────────────────────
//
// Un appel téléphonique remonté depuis un provider VoIP (OVH Telephony /
// Telnyx). Alimente le tab Calls du dashboard. Port de la logique `sipCall`
// du legacy veridian-analytics.
//
// Les credentials VoIP du tenant vivent dans `TenantCredential` (kind
// `voip_ovh` / `voip_telnyx`, table U8) — pas de table de creds dédiée ici.
// Le cron B-VOIP les déchiffre pour pull les CDR puis upsert ici.
//
// Idempotence : `@@unique([provider, externalId])` — un re-sync upsert sans
// dupliquer (`externalId` est l'id stable de l'appel chez le provider).
//
// `visitorId` : matché si l'appel provient d'un clic `tel:` tracké par le
// tracker Veridian (relie l'appel téléphonique à la session web).

model SipCall {
  id            String   @id @default(cuid())
  tenantId      String
  siteId        String?
  provider      String   // 'ovh' | 'telnyx'
  externalId    String   // id de l'appel chez le provider
  direction     String   // 'inbound' | 'outbound'
  fromNumber    String
  toNumber      String
  durationSec   Int      @default(0)
  status        String   // 'answered' | 'missed' | 'busy' | 'failed'
  recordingUrl  String?
  startedAt     DateTime
  visitorId     String?  // matché si l'appel vient d'un clic tel: tracké
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([tenantId, startedAt])
}
